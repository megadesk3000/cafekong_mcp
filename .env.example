CAFEKONG_BASE_URL=https://www.cafekong.de
# Nur für den gehosteten OAuth-Transport. Derselbe Wert wird in der CafeKong-App gesetzt.
CAFEKONG_MCP_SERVICE_SECRET=replace-with-a-long-random-secret
CAFEKONG_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
MCP_RESOURCE_URL=https://mcp.cafekong.de/api/mcp
# Nur für den lokalen stdio-Transport. Bei Vercel kommt der Token vom MCP-Client.
CAFEKONG_BOT_TOKEN=ckbot_replace_me
